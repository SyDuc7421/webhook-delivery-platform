# Dummy values only. Copy to .env (make setup does this). Read ONLY by backend/internal/config.

# ---- app ----------------------------------------------------------------
APP_ENV=local                 # local | dev | aws
APP_VERSION=dev
API_PORT=8080
METRICS_ADDR=:9100            # every process serves /metrics here
LOG_LEVEL=debug               # debug | info | warn | error
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

# ---- postgres -----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=webhook
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=webhook_platform
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m

# ---- redis (loss-tolerant state only) -----------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
CACHE_TTL=60s                 # NFR-P3: must stay <= 60s

# ---- kafka --------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
KAFKA_PARTITIONS=6
KAFKA_TOPIC_PREFIX=           # empty locally; per-test prefix in integration tests

# ---- pipeline -----------------------------------------------------------
OUTBOX_POLL_INTERVAL=200ms
OUTBOX_BATCH_SIZE=100
RETRY_TIERS=1m,10m,1h,6h      # FR-D4
INGEST_MAX_PAYLOAD_BYTES=262144   # FR-I2: 256 KB
INGEST_RATE_LIMIT_PER_MIN=600     # FR-I5, per org

# ---- outbound webhooks --------------------------------------------------
WEBHOOK_TIMEOUT=15s           # NFR-S3
WEBHOOK_MAX_RESPONSE_BYTES=4096
WEBHOOK_TIMESTAMP_TOLERANCE=5m
WEBHOOK_ALLOW_HTTP=true       # FR-E5: local dev only
SSRF_ALLOWLIST_HOSTS=api      # NFR-S2: only the built-in test receiver

# ---- observability ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- auth ---------------------------------------------------------------
JWT_SECRET=dev_only_never_use_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---- local tools --------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
