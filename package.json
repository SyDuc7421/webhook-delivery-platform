{
  "name": "webhook-delivery-platform-hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Git hook tooling only. The web app has its own package.json in /web.",
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/**/*.go": [
      "gofumpt -w",
      "goimports -local github.com/SyDuc7421/webhook-delivery-platform/backend -w"
    ],
    "*.{yml,yaml,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
